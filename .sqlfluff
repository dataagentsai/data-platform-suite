# sqlfluff config — T-SQL dialect for Azure SQL DB metadata schema + procs.
# See docs/quality_gates.md.

[sqlfluff]
dialect = tsql
templater = raw
max_line_length = 120
exclude_rules =
    # L016: line length — DDL with long column names + comments triggers
    # false positives. Width is enforced via max_line_length above when feasible.
    L016,
    # TQ01: sp_ prefix on user procs. Microsoft's caution applies only when
    # procs live in master DB (where they collide with system procs). Our
    # procs are scoped to the customer metadata DB; keeping sp_ keeps the
    # naming consistent with docs/metadata_schema.md.
    TQ01
processes = -1

[sqlfluff:indentation]
tab_space_size = 4
indent_unit = space

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = upper

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = upper

[sqlfluff:rules:references.consistent]
force_enable = True

[sqlfluff:rules:layout.long_lines]
ignore_comment_lines = True
