{
  "datasets": [
    {
      "displayName": "files daily",
      "name": "sources_ingestion__files_daily",
      "queryLines": [
        "SELECT `day`, MEASURE(`loaded`) AS `loaded`, MEASURE(`duplicate`) AS `duplicate`, MEASURE(`rejected`) AS `rejected`\n",
        "FROM `dev_ops`.`ops`.`mv_ops_ingestion`\n",
        "GROUP BY `day`\n",
        "ORDER BY `day`"
      ]
    },
    {
      "displayName": "rows daily",
      "name": "sources_ingestion__rows_daily",
      "queryLines": [
        "SELECT `day`, `source`, MEASURE(`rows`) AS `rows`\n",
        "FROM `dev_ops`.`ops`.`mv_ops_dataset_runs`\n",
        "GROUP BY `day`, `source`\n",
        "ORDER BY `day`, `source`"
      ]
    },
    {
      "displayName": "held",
      "name": "sources_ingestion__held",
      "queryLines": [
        "SELECT `day`, `dataset`, `file_name`, `status`, `rows`, `reason`, `run_id`\n",
        "FROM `dev_ops`.`ops`.`ops_files_held`\n",
        "ORDER BY `day`"
      ]
    },
    {
      "displayName": "by dataset",
      "name": "sources_ingestion__by_dataset",
      "queryLines": [
        "SELECT `dataset`, MEASURE(`runs`) AS `runs`, MEASURE(`rows`) AS `rows`\n",
        "FROM `dev_ops`.`ops`.`mv_ops_dataset_runs`\n",
        "GROUP BY `dataset`\n",
        "ORDER BY `dataset`"
      ]
    },
    {
      "displayName": "detectors",
      "name": "sources_ingestion__detectors",
      "queryLines": [
        "SELECT `day`, `dataset`, `step`, `severity`, `count`, `message`, `run_id`\n",
        "FROM `dev_ops`.`ops`.`ops_steps`\n",
        "WHERE `kind` = 'detect'\n",
        "ORDER BY `day`"
      ]
    }
  ],
  "pages": [
    {
      "displayName": "Sources and ingestion",
      "layout": [
        {
          "position": {
            "height": 2,
            "width": 6,
            "x": 0,
            "y": 0
