      "name": "mv_scrap_scrap_rate_counter_all",
      "displayName": "Scrap rate %",
      "queryLines": [
        "SELECT MEASURE(`Scrap rate %`) AS value FROM `prod_gold`.`manufacturing`.`mv_scrap`"
      ]
    },
    {
      "name": "mv_scrap_scrap_rate_trend_day",
