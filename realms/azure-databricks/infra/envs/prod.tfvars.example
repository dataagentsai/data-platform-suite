# prod: Copy to prod.tfvars (git-ignored) and fill the owner values; see RUNBOOK.md.
# The subscription id is NOT set here: export TF_VAR_subscription_id (or ARM_SUBSCRIPTION_ID).
env         = "prod"
name_prefix = "changeme" # short, unique to the owner; letters and digits; storage account names are global
location    = "eastus2"  # must offer Lakebase (README, Region)

force_destroy              = false
key_vault_purge_protection = true
lakebase_enabled           = true
budget_usd                 = 20
budget_emails              = [] # owner addresses go in the untracked prod.tfvars
